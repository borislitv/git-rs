+    let started = diagnostic.as_ref().map(|_| std::time::Instant::now());
+    let (hunks, skipped) = if indexed {
+        process_changes_indexed(hunks, changes, suspect, parent)
+    } else {
+        (process_changes(hunks, changes, suspect, parent), 0)
+    };
+    if let (Some(diagnostic), Some(started)) = (diagnostic.as_mut(), started) {
+        diagnostic.attribution += started.elapsed();
+        diagnostic.indexed_change_pairs += usize::from(indexed);
+        diagnostic.skipped_changes += skipped;
