+        // immutable base remains borrowed until delta application completes.
+        let delta_size = self.decoded_object_size(entry.decompressed_size)?;
+        resize_with_limit(out, delta_size, self.alloc_limit_bytes)?;
+        let compressed_size = self.decompress_entry_from_data_offset(entry.data_offset, inflate, out)?;
+        let (base_size, base_header_size) = delta::decode_header_size(out)?;
+        let base_size = self.decoded_object_size(base_size)?;
